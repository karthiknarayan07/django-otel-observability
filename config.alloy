// ALLOY CONFIGURATION FOR OPENTELEMETRY TRACES, METRICS & LOGS

otelcol.receiver.otlp "default" {
    grpc {
        endpoint = "0.0.0.0:4317"
    }
    http {
        endpoint = "0.0.0.0:4318"
    }

    output {
        traces  = [otelcol.processor.transform.add_resource_attributes.input]
        metrics = [otelcol.processor.transform.add_resource_attributes.input]
        logs    = [otelcol.processor.transform.add_resource_attributes.input]
    }
}

// OTel Transform Processor to set Resource Attributes
otelcol.processor.transform "add_resource_attributes" {
    error_mode = "ignore"

    log_statements {
        context = "log"
        statements = [
            "set(resource.attributes[\"namespace\"], \"" + sys.env("NAMESPACE") + "\")",
            "set(resource.attributes[\"service.name\"], \"" + sys.env("SERVICE_NAME") + "\")",
        ]
    }

    metric_statements {
        context = "datapoint"
        statements = [
            "set(resource.attributes[\"namespace\"], \"" + sys.env("NAMESPACE") + "\")",
            "set(resource.attributes[\"service.name\"], \"" + sys.env("SERVICE_NAME") + "\")",
        ]
    }

    trace_statements {
        context = "span"
        statements = [
            "set(resource.attributes[\"namespace\"], \"" + sys.env("NAMESPACE") + "\")",
            "set(resource.attributes[\"service.name\"], \"" + sys.env("SERVICE_NAME") + "\")",
        ]
    }

    output {
        metrics = [otelcol.processor.batch.metrics.input]
        traces  = [otelcol.processor.batch.traces.input]
        logs    = [otelcol.processor.batch.logs.input]
    }
}

// OTel Batch Processors
otelcol.processor.batch "traces" {
    timeout             = "10s"
    send_batch_size     = 16
    send_batch_max_size = 128

    output {
        traces = [otelcol.exporter.otlp.tempo.input]
    }
}

otelcol.processor.batch "metrics" {
    output {
        metrics = [otelcol.exporter.otlp.mimir.input]
    }
}

otelcol.processor.batch "logs" {
    timeout             = "5s"
    send_batch_size     = 16
    send_batch_max_size = 128

    output {
        logs = [otelcol.exporter.loki.loki_exporter.input]
    }
}

// EXPORTERS

otelcol.exporter.otlp "tempo" {
    client {
        endpoint = sys.env("TEMPO_URL")

        tls {
            insecure             = true
            insecure_skip_verify = true
        }
    }
}

otelcol.exporter.otlp "mimir" {
    client {
        endpoint = sys.env("MIMIR_URL")

        tls {
            insecure             = true
            insecure_skip_verify = true
        }
    }
}

otelcol.exporter.loki "loki_exporter" {
    forward_to = [loki.process.clean_logs.receiver]
}

loki.process "clean_logs" {
    forward_to = [loki.write.default.receiver]

    stage.json {
        expressions = {
            raw_body = "body",
        }
    }

    stage.output {
        source = "raw_body"
    }

    stage.label_drop {
        values = ["job", "instance", "exporter", "filename"]
    }
}

loki.write "default" {
    endpoint {
        url = sys.env("LOKI_URL")
    }

    external_labels = {
        namespace    = sys.env("NAMESPACE"),
        service_name = sys.env("SERVICE_NAME"),
    }
}